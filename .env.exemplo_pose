# Copie para .env e ajuste. Todos os valores são opcionais.

# --- Modelo de pose ---
POSE_MODELO=lite            # lite (rápido) | full | heavy (preciso)
POSE_MAX_PESSOAS=3

# --- Lógica de queda (calibre na instituição) ---
QUEDA_ANGULO_DEITADO=60     # graus do tronco vs vertical para considerar "deitado"
QUEDA_ANGULO_EM_PE=35
QUEDA_VELOCIDADE=1.2        # comprimentos de tronco/s de descida do quadril = queda brusca
QUEDA_TEMPO_CONFIRMA=2      # s deitado após queda brusca para alertar
QUEDA_TEMPO_NO_CHAO=8       # s deitado sem queda vista para alertar
QUEDA_TEMPO_RECUPERACAO=1.5

# --- Alertas ---
ALERTA_COOLDOWN=30
WHATSAPP_URL=http://localhost:3000/client/sendMessage/ABCD
WHATSAPP_CHAT_ID=55DDDNUMERO@c.us

# --- Câmera (servidor.py) ---
CAMERA_FONTE=0              # índice da webcam, URL RTSP/HTTP ou arquivo de vídeo
CAMERA_NOME=Quarto 1
CAMERA_LOCAL=Térreo

# --- Banco PostgreSQL (opcional; sem isto o sistema usa o arquivo local sentinela.db) ---
# Opção 1: uma linha só
# DATABASE_URL=postgresql://usuario:senha@servidor:5432/nome_do_banco
# Opção 2: variáveis separadas (padrão do PostgreSQL)
# PGHOST=servidor
# PGPORT=5432
# PGDATABASE=nome_do_banco
# PGUSER=usuario
# PGPASSWORD=senha
# PGSSLMODE=prefer

# --- Web Push: aviso no celular com o app fechado ---
# Gere o par com:  python -m sentinela_api.push --gerar-chaves
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTATO=mailto:admin@exemplo.com
