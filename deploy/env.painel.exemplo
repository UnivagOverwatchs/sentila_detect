# Modelo do arquivo /opt/sentinela/.env na VPS (docker --env-file: sem aspas, sem espaços em volta do "=").
# Preencha os valores com nano; NUNCA envie este arquivo preenchido por chat ou e-mail.

# Banco: o container usa a rede do servidor, então o Postgres está em 127.0.0.1.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=sentinela
PGUSER=sentinelas
PGPASSWORD=COLE_A_SENHA_DO_BANCO

# Login obrigatório e cookie só por HTTPS.
LOGIN_OBRIGATORIO=1
COOKIE_SEGURO=1

# Web Push: as MESMAS chaves do computador que detecta as quedas (senão o push não chega).
VAPID_PUBLIC_KEY=COLE_A_CHAVE_PUBLICA
VAPID_PRIVATE_KEY=COLE_A_CHAVE_PRIVADA
VAPID_CONTATO=mailto:admin@example.com
